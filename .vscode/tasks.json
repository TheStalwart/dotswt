{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Deploy with dotbot",
            "type": "shell",
            "command": "dotbot",
            "args": [
                "-d",
                "${workspaceFolder}",
                "-c",
                "${workspaceFolder}/dotbot.yaml",
                "-vv"
            ],
            "options": {
                "env": {
                    // VSCode installed via Linuxbrew
                    // doesn't have the correct $PATH set
                    // to run other apps installed via Linuxbrew
                    "PATH": "${env:PATH}:/home/linuxbrew/.linuxbrew/bin"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [],
            "detail": "Run dotbot to deploy dotfiles"
        }
    ]
}