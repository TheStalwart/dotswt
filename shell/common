# Use path-agnostic availability checks!
# https://stackoverflow.com/questions/592620/how-can-i-check-if-a-program-exists-from-a-bash-script

# Better coreutils
if which eza > /dev/null 2>&1; then
	alias l="eza -F"
	alias la="eza -F -a"
	alias ll="eza -F -la"
elif which exa > /dev/null 2>&1; then
	alias l="exa -F"
	alias la="exa -Fa"
	alias ll="exa -Fla"
fi

if which bat > /dev/null 2>&1; then
	alias c="bat"
elif which batcat > /dev/null 2>&1; then
	alias c="batcat"
fi

# bash fine-tuning
if [[ ${BASH_VERSINFO[0]} -gt 3 ]]; then \
	shopt -s autocd
fi

# don't freeze on ctrl+s
stty -ixon

# tmux & screen
if which tmux > /dev/null 2>&1; then
	# Replicate `screen -DRR` behavior with tmux
	alias s="tmux -f "$DOTSWT/tmux.conf" new-session -AD -s 0"
else
	# I have 20+ years of muscle memory with GNU Screen
	# but the list of issues unlikely to be fixed is growing:
	# - btop 256-color support is broken in screen
	# - statusline backtick commands make the session lag every time it refreshes
	alias s="screen -DRR"
fi
export SCREENRC=$DOTSWT/screenrc

alias gds="git diff && git status"

# Add VSCode "code" command to $PATH
if [ -d "/Applications/Visual Studio Code.app" ]; then
	export PATH="$PATH:/Applications/Visual Studio Code.app/Contents/Resources/app/bin"
fi

# Map ata??.?? IDs to disk drive serial numbers
# Generated by ChatGPT
# confirmed to work on:
# - TrueNAS 25.10
# - Bazzite-dx 44.20260803
ata-map() {
    printf "%-6s %-8s %-22s %s\n" "PORT" "DEVICE" "SERIAL" "MODEL"

    for dev in /dev/sd? /dev/sd??; do
        [ -b "$dev" ] || continue

        props=$(udevadm info --query=property --name="$dev")

        syspath=$(udevadm info --query=path --name="$dev") || continue

        ata=$(printf '%s\n' "$syspath" |
            grep -o 'ata[0-9]\+' |
            head -n1)

        [ -n "$ata" ] || continue

        serial=$(printf '%s\n' "$props" |
            sed -n 's/^ID_SERIAL_SHORT=//p')

        model=$(printf '%s\n' "$props" |
            sed -n 's/^ID_MODEL=//p')

        printf "%-6s %-8s %-22s %s\n" \
            "$ata" \
            "${dev#/dev/}" \
            "${serial:--}" \
            "${model:--}"
    done | sort -V
}
